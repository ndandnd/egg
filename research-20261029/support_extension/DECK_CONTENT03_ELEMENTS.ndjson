{"id":"sh/kfy1oju1","text":"04 / NEW: ADDING FEASIBLE ALTERNATIVES","position":{"left":78,"top":28,"width":1100,"height":28},"style":{"fontSize":18,"typeface":"Aptos","color":"#637176","bold":true,"alignment":"left"}}
{"id":"sh/l07ixovm","text":"An old plan stays unsupported. A new plan may restore support.","position":{"left":78,"top":78,"width":1120,"height":108},"style":{"fontSize":42,"typeface":"Aptos","color":"#102B36","bold":true,"alignment":"left"}}
{"id":"sh/vutknixo","text":"At an old plan's own price","position":{"left":80,"top":205,"width":520,"height":70},"style":{"fontSize":28,"typeface":"Aptos","color":"#315A63","bold":true,"alignment":"left"}}
{"id":"sh/u903edg3","text":"Adding choices can only lower the best alternative bill.\n\nIts regret cannot decrease.","position":{"left":80,"top":290,"width":520,"height":250},"style":{"fontSize":27,"typeface":"Aptos","color":"#102B36","alignment":"left"}}
{"id":"sh/hwb2psfu","text":"For the enlarged problem","position":{"left":655,"top":205,"width":520,"height":70},"style":{"fontSize":28,"typeface":"Aptos","color":"#315A63","bold":true,"alignment":"left"}}
{"id":"sh/wv2lgne9","text":"Both the physical optimum D and hull optimum CH may fall.\n\nA newly feasible plan can make D = CH.","position":{"left":655,"top":290,"width":520,"height":250},"style":{"fontSize":27,"typeface":"Aptos","color":"#102B36","alignment":"left"}}
{"id":"sh/769kjyxs","text":"Do not confuse “this fleet remains unsupported” with “every optimum remains unsupported.”","position":{"left":80,"top":576,"width":1120,"height":95},"style":{"fontSize":27,"typeface":"Aptos","color":"#315A63","bold":true,"alignment":"left"}}
{"id":"sh/m503atg7","text":"11","position":{"left":1160,"top":675,"width":50,"height":24},"style":{"fontSize":16,"typeface":"Aptos","color":"#637176","alignment":"left"}}
{"id":"sh/9kj69sfe","text":"04 / NEW: A SURVIVAL CERTIFICATE","position":{"left":78,"top":28,"width":1100,"height":28},"style":{"fontSize":18,"typeface":"Aptos","color":"#637176","bold":true,"alignment":"left"}}
{"id":"sh/8japgnyt","text":"Extra movement alone cannot remove this obstruction.","position":{"left":78,"top":78,"width":1120,"height":108},"style":{"fontSize":42,"typeface":"Aptos","color":"#102B36","bold":true,"alignment":"left"}}
{"id":"sh/vmlobixk","text":"Keep the physical model fixed","position":{"left":80,"top":205,"width":520,"height":70},"style":{"fontSize":28,"typeface":"Aptos","color":"#315A63","bold":true,"alignment":"left"}}
{"id":"sh/als7idgz","text":"Same services, 20 kWh batteries, charging windows, power and full refill.\n\nAllow added movements with nonnegative energy and extra cost.","position":{"left":80,"top":290,"width":520,"height":250},"style":{"fontSize":27,"typeface":"Aptos","color":"#102B36","alignment":"left"}}
{"id":"sh/hwzmpwfi","text":"Why the proof works","position":{"left":655,"top":205,"width":520,"height":70},"style":{"fontSize":28,"typeface":"Aptos","color":"#315A63","bold":true,"alignment":"left"}}
{"id":"sh/gvqlgryx","text":"Every added plan has an old feasible plan with no higher operating cost or load in either interval.\n\nThis dominance also applies inside mixtures.","position":{"left":655,"top":290,"width":520,"height":250},"style":{"fontSize":27,"typeface":"Aptos","color":"#102B36","alignment":"left"}}
