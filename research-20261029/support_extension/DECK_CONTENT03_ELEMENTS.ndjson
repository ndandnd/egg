{"id":"sh/l0zatcby","text":"Understanding EGG","position":{"left":78,"top":126,"width":1110,"height":180},"style":{"fontSize":64,"typeface":"Aptos","color":"#102B36","bold":true,"alignment":"left"}}
{"id":"sh/kzq9k7ad","text":"Bus scheduling, grid prices and the evidence behind the paper","position":{"left":82,"top":340,"width":1030,"height":130},"style":{"fontSize":32,"typeface":"Aptos","color":"#315A63","alignment":"left"}}
{"id":"sh/zehsr2t8","text":"A self-study guide. Research state on 29 October 2026","position":{"left":82,"top":580,"width":1080,"height":70},"style":{"fontSize":22,"typeface":"Aptos","color":"#637176","alignment":"left"}}
{"id":"sh/j6l47qt8","text":"01 / THE RESEARCH QUESTION","position":{"left":78,"top":28,"width":1100,"height":28},"style":{"fontSize":18,"typeface":"Aptos","color":"#637176","bold":true,"alignment":"left"}}
{"id":"sh/i5cny5sn","text":"Can efficient bus schedules be supported by grid prices?","position":{"left":78,"top":78,"width":1120,"height":108},"style":{"fontSize":42,"typeface":"Aptos","color":"#102B36","bold":true,"alignment":"left"}}
{"id":"sh/gr61snq5","text":"What is established","position":{"left":80,"top":220,"width":520,"height":65},"style":{"fontSize":30,"typeface":"Aptos","color":"#315A63","bold":true,"alignment":"left"}}
{"id":"sh/1sf21srq","text":"Exact small-model classification and a certified public case show that an optimal fleet can lack support at its own marginal prices.","position":{"left":80,"top":310,"width":520,"height":215},"style":{"fontSize":29,"typeface":"Aptos","color":"#102B36","alignment":"left"}}
{"id":"sh/epojqx8f","text":"What remains open","position":{"left":655,"top":220,"width":520,"height":65},"style":{"fontSize":30,"typeface":"Aptos","color":"#315A63","bold":true,"alignment":"left"}}
{"id":"sh/fqxkz290","text":"How prevalent is this in realistic fleets? Which scalable method changes decisions enough to beat strong classical controls?","position":{"left":655,"top":310,"width":520,"height":215},"style":{"fontSize":29,"typeface":"Aptos","color":"#102B36","alignment":"left"}}
{"id":"sh/of61w7qh","text":"The strongest contribution is analytical. An ML contribution remains unproven.","position":{"left":80,"top":576,"width":1120,"height":95},"style":{"fontSize":27,"typeface":"Aptos","color":"#315A63","bold":true,"alignment":"left"}}
