{"id":"sh/2dw7id03","text":"A positive physical–hull gap rules out own-price support.","position":{"left":78,"top":78,"width":1120,"height":108},"style":{"fontSize":42,"typeface":"Aptos","color":"#102B36","bold":true,"alignment":"left"}}
{"id":"sh/sjalcjy1","text":"The inequality","position":{"left":80,"top":205,"width":520,"height":70},"style":{"fontSize":28,"typeface":"Aptos","color":"#315A63","bold":true,"alignment":"left"}}
