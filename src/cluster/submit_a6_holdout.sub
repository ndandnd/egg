#!/bin/bash
# Frozen A6 holdout array: 64 fresh A2 + 64 selected a6_a4 cells.
# launch_a6_holdout.sh performs the committed-selection, exact-grid, clean-
# tree, GRB, and whole-population feasibility gates before submitting.
# Each task independently reconstructs and validates PREFLIGHT.json before
# creating any method-cell output, then resumes via atomic checkpoints.
#
# Budget exhaustion is valid completed science; it must not be converted into
# an array failure merely because the cell did not certify by call 240.
#
#SBATCH --job-name=egg-a6-holdout
#SBATCH --output=slurm-%x-%A_%a.out
#SBATCH --mail-type=END,FAIL,REQUEUE
#SBATCH --mail-user=nc437@cornell.edu
#SBATCH --requeue
#SBATCH --array=0-127%12
#SBATCH --cpus-per-task=4
#SBATCH --mem=8G
#SBATCH --time=24:00:00

set -euo pipefail
SUBMIT_DIR="${SLURM_SUBMIT_DIR:-$(pwd)}"
if [[ -f "${SUBMIT_DIR}/experiments/run_a6_holdout.py" ]]; then
    WORK_DIR="${SUBMIT_DIR}"
elif [[ -f "${SUBMIT_DIR}/src/experiments/run_a6_holdout.py" ]]; then
    WORK_DIR="${SUBMIT_DIR}/src"
else
    echo "ERROR: could not locate the egg src directory from ${SUBMIT_DIR}" >&2
    exit 1
fi
cd "${WORK_DIR}"
source "${WORK_DIR}/cluster/unicorn_env.sh"

if [[ -z "${EGGLAB_HOLDOUT_CODE_COMMIT:-}" ]]; then
    echo "ERROR: missing launcher-pinned EGGLAB_HOLDOUT_CODE_COMMIT." >&2
    exit 1
fi

python experiments/run_a6_holdout.py \
    --cell "${SLURM_ARRAY_TASK_ID}" \
    --out runs/a6_holdout
