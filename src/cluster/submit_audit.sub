#!/bin/bash
# Audit job: runs the effective-semantics audit over one or more runs roots.
# Launch via cluster/launch_audit.sh. Exits nonzero if ANY root fails its
# audit (incomplete checkpoints, unresolved replay failures, failed
# revalidations, non-OPTIMAL solves, or unconverged certifications).
#
# This is a proper #!/bin/bash batch script on purpose: `sbatch --wrap` runs
# under /bin/sh, where `source` does not exist (2026-08-16 incident).
#
#SBATCH --job-name=egg-audit
#SBATCH --output=slurm-%x-%j.out
#SBATCH --mail-type=END,FAIL,REQUEUE
#SBATCH --mail-user=nc437@cornell.edu
#SBATCH --requeue
#SBATCH --cpus-per-task=1
#SBATCH --mem=4G
#SBATCH --time=01:00:00

set -euo pipefail
SUBMIT_DIR="${SLURM_SUBMIT_DIR:-$(pwd)}"
if [[ -f "${SUBMIT_DIR}/experiments/audit_runs.py" ]]; then
    WORK_DIR="${SUBMIT_DIR}"
elif [[ -f "${SUBMIT_DIR}/src/experiments/audit_runs.py" ]]; then
    WORK_DIR="${SUBMIT_DIR}/src"
else
    echo "ERROR: could not locate the egg src directory from ${SUBMIT_DIR}" >&2
    exit 1
fi
cd "${WORK_DIR}"
source "${WORK_DIR}/cluster/unicorn_env.sh"

ROOTS="${EGG_AUDIT_ROOTS:?EGG_AUDIT_ROOTS is required (space-separated runs roots)}"
rc=0
for ROOT in ${ROOTS}; do
    echo "=== auditing ${ROOT} ==="
    if python experiments/audit_runs.py "${ROOT}"; then
        echo "[pass] ${ROOT}"
    else
        echo "[FAIL] ${ROOT}" >&2
        rc=1
    fi
done
exit "${rc}"
