#!/bin/bash
# Audit job: runs the effective-semantics audit over one or more runs roots.
# Launch via cluster/launch_audit.sh. Exits nonzero if ANY root fails its
# audit (incomplete checkpoints, unresolved replay failures, failed
# revalidations, non-OPTIMAL solves, or unconverged certifications).
#
# This is a proper #!/bin/bash batch script on purpose: `sbatch --wrap` runs
# under /bin/sh, where `source` does not exist (2026-08-16 incident).
#
#SBATCH --job-name=egg-audit
#SBATCH --output=slurm-%x-%j.out
#SBATCH --mail-type=END,FAIL,REQUEUE
#SBATCH --mail-user=nc437@cornell.edu
#SBATCH --requeue
#SBATCH --cpus-per-task=1
#SBATCH --mem=4G
#SBATCH --time=01:00:00

set -euo pipefail
SUBMIT_DIR="${SLURM_SUBMIT_DIR:-$(pwd)}"
if [[ -f "${SUBMIT_DIR}/experiments/audit_runs.py" ]]; then
    WORK_DIR="${SUBMIT_DIR}"
elif [[ -f "${SUBMIT_DIR}/src/experiments/audit_runs.py" ]]; then
    WORK_DIR="${SUBMIT_DIR}/src"
else
    echo "ERROR: could not locate the egg src directory from ${SUBMIT_DIR}" >&2
    exit 1
fi
cd "${WORK_DIR}"
source "${WORK_DIR}/cluster/unicorn_env.sh"

# EGG_AUDIT_ROOTS holds space-separated root SPECS with expected-count gates:
#   path[:cells=N][:loops=N][:sweeps=N][:static=N][:cg=N]
# e.g. runs/phase1:cells=128:loops=128:static=4
# A root without gates is audited without expected counts (found checkpoints
# must still be complete) — prefer explicit gates for closeout audits.
ROOTS="${EGG_AUDIT_ROOTS:?EGG_AUDIT_ROOTS is required (space-separated root specs)}"
rc=0
for SPEC in ${ROOTS}; do
    IFS=':' read -r -a PARTS <<< "${SPEC}"
    ROOT="${PARTS[0]}"
    ARGS=()
    for KV in "${PARTS[@]:1}"; do
        case "${KV}" in
            cells=*)  ARGS+=(--expect-cells "${KV#cells=}") ;;
            loops=*)  ARGS+=(--expect-loops "${KV#loops=}") ;;
            sweeps=*) ARGS+=(--expect-sweeps "${KV#sweeps=}") ;;
            static=*) ARGS+=(--expect-static "${KV#static=}") ;;
            cg=*)     ARGS+=(--expect-cg "${KV#cg=}") ;;
            *) echo "ERROR: unknown expectation '${KV}' in spec '${SPEC}'" >&2; exit 2 ;;
        esac
    done
    echo "=== auditing ${ROOT} (${PARTS[*]:1}) ==="
    if python experiments/audit_runs.py "${ROOT}" "${ARGS[@]}"; then
        echo "[pass] ${ROOT}"
    else
        echo "[FAIL] ${ROOT}" >&2
        rc=1
    fi
done
exit "${rc}"
