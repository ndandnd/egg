#!/bin/bash
# B3 internal-uplift factor pilot array (60 cells, A2 only). Launch via
# cluster/launch_b3_factor_pilot.sh, which derives the array size from --list
# and refuses to submit unless it is exactly 60 (and the --dry-run binding
# preflight passes).
#
# Gurobi-only: EGGLAB_REQUIRE_GRB=1 forces the GRB backend; a non-GRB
# fallback aborts the task instead of silently solving with CBC.
#
# Preemption safety: --requeue + atomic per-oracle-call checkpoints in
# egglab/b2a2.py and the dictator checkpoint; a requeued task repeats at
# most one in-flight solve and never loses completed columns or corrupts
# bounds.
#
#SBATCH --job-name=egg-b3-factor-pilot
#SBATCH --output=slurm-%x-%A_%a.out
#SBATCH --mail-type=END,FAIL,REQUEUE
#SBATCH --mail-user=nc437@cornell.edu
#SBATCH --requeue
#SBATCH --array=0-59%12
#SBATCH --cpus-per-task=4
#SBATCH --mem=8G
#SBATCH --time=24:00:00

set -euo pipefail

# The run directory is threaded from the launcher via EGG_RUN_OUT (kept
# RELATIVE: the script cds to the src working directory, so a relative
# path resolves identically in the launcher and in every array task).
# A set-but-empty value is a configuration error, never a silent default.
if [[ -n "${EGG_RUN_OUT+x}" && -z "${EGG_RUN_OUT}" ]]; then
    echo "ERROR: EGG_RUN_OUT is set but empty; refusing to guess the run directory." >&2
    exit 1
fi
OUT="${EGG_RUN_OUT:-runs/b3_factor_pilot}"

SUBMIT_DIR="${SLURM_SUBMIT_DIR:-$(pwd)}"
if [[ -f "${SUBMIT_DIR}/experiments/run_b3_factor_pilot.py" ]]; then
    WORK_DIR="${SUBMIT_DIR}"
elif [[ -f "${SUBMIT_DIR}/src/experiments/run_b3_factor_pilot.py" ]]; then
    WORK_DIR="${SUBMIT_DIR}/src"
else
    echo "ERROR: could not locate the egg src directory from ${SUBMIT_DIR}" >&2
    exit 1
fi
cd "${WORK_DIR}"

OUT="$(python3 -c \
    'import sys; from experiments.b3_factor_pilot import validate_run_out; print(validate_run_out(sys.argv[1], src_root=sys.argv[2]))' \
    "${OUT}" "${WORK_DIR}")"

export EGGLAB_REQUIRE_GRB=1
# Interpreter/environment overrides are accepted only behind an explicit
# off-cluster harness marker, and that marker is refused when scheduler
# commands or scheduler identity variables make a real allocation plausible.
if [[ -n "${EGG_SUBMIT_SELFTEST:-}" ]]; then
    if command -v sbatch >/dev/null 2>&1 \
            || command -v scontrol >/dev/null 2>&1 \
            || command -v srun >/dev/null 2>&1 \
            || [[ -n "${SLURM_JOB_ID:-}${SLURM_ARRAY_JOB_ID:-}${SLURM_CLUSTER_NAME:-}" ]]; then
        echo "ERROR: EGG_SUBMIT_SELFTEST refused where a scheduler is reachable." >&2
        exit 1
    fi
    PYTHON="${EGG_PYTHON:-python}"
    ENV_SCRIPT="${EGG_ENV_SCRIPT:-/dev/null}"
    TASK_ID="${EGG_SELFTEST_ARRAY_TASK_ID:?self-test task id is required}"
else
    if [[ -n "${EGG_PYTHON+x}" || -n "${EGG_ENV_SCRIPT+x}" ]]; then
        echo "ERROR: EGG_PYTHON/EGG_ENV_SCRIPT are test-only overrides; refusing production task." >&2
        exit 1
    fi
    PYTHON="python"
    ENV_SCRIPT="${WORK_DIR}/cluster/unicorn_env.sh"
    TASK_ID="${SLURM_ARRAY_TASK_ID:?SLURM_ARRAY_TASK_ID is required}"
    # PREEXISTING pilot hardening: authenticate read-only JOB.json + digest,
    # manifest, array id, run commit, and launch token before invoking the
    # per-cell driver. The driver repeats this check before creating output.
    python3 -c \
        'import sys; from experiments import b3_factor_pilot as bp; run=bp.load_run_manifest(sys.argv[1]); bp.assert_worker_authorized(sys.argv[1], run)' \
        "${OUT}"
fi
source "${ENV_SCRIPT}"

${PYTHON} experiments/run_b3_factor_pilot.py --cell "${TASK_ID}" \
    --out "${OUT}"
