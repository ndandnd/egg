#!/bin/bash
# Fine Phase-2 boundary replication: 8 seeds x 2 sizes x 4 slots, 0.01 grid.
#SBATCH --job-name=egg-boundary
#SBATCH --output=slurm-%x-%A_%a.out
#SBATCH --mail-type=END,FAIL,REQUEUE
#SBATCH --mail-user=nc437@cornell.edu
#SBATCH --requeue
#SBATCH --array=0-63%16
#SBATCH --cpus-per-task=4
#SBATCH --mem=8G
#SBATCH --time=24:00:00

set -euo pipefail
SUBMIT_DIR="${SLURM_SUBMIT_DIR:-$(pwd)}"
if [[ -f "${SUBMIT_DIR}/experiments/run_phase2.py" ]]; then
    WORK_DIR="${SUBMIT_DIR}"
elif [[ -f "${SUBMIT_DIR}/src/experiments/run_phase2.py" ]]; then
    WORK_DIR="${SUBMIT_DIR}/src"
else
    echo "ERROR: could not locate the egg src directory from ${SUBMIT_DIR}" >&2
    exit 1
fi
cd "${WORK_DIR}"
source "${WORK_DIR}/cluster/unicorn_env.sh"

STAMP="${EGG_OVERNIGHT_STAMP:?EGG_OVERNIGHT_STAMP is required}"
python experiments/run_phase2.py \
    --cell "${SLURM_ARRAY_TASK_ID}" \
    --seeds 0 1 2 3 4 5 6 7 \
    --n-trips 8 12 \
    --slots 8 12 16 20 \
    --shape duck \
    --d-min -1.5 \
    --d-max 1.5 \
    --d-step 0.01 \
    --out "runs/overnight/${STAMP}/boundary_fine"
