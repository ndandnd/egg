#!/bin/bash
# Phase 1 array job — Unicorn cluster (Slurm).
#
# Preemption safety: --requeue + checkpointed drivers. A preempted/requeued
# task reruns the same command and resumes from its cell checkpoint; no work
# unit is lost beyond the in-flight MILP solve.
#
# Before first use:
#   1. Install src/requirements.txt in the Unicorn conda environment.
#      The shared Unicorn environment is configured in unicorn_env.sh.
#   2. Size the array: N_CELLS-1 where N_CELLS comes from
#      `python experiments/run_phase1.py --list`.
#
#SBATCH --job-name=egg-phase1
#SBATCH --output=slurm-%x-%A_%a.out
#SBATCH --mail-type=END,FAIL,REQUEUE
#SBATCH --requeue
#SBATCH --array=0-63
#SBATCH --cpus-per-task=4
#SBATCH --mem=8G
#SBATCH --time=24:00:00

set -euo pipefail
SUBMIT_DIR="${SLURM_SUBMIT_DIR:-$(pwd)}"
if [[ -f "${SUBMIT_DIR}/experiments/run_phase1.py" ]]; then
    WORK_DIR="${SUBMIT_DIR}"
elif [[ -f "${SUBMIT_DIR}/src/experiments/run_phase1.py" ]]; then
    WORK_DIR="${SUBMIT_DIR}/src"
else
    echo "ERROR: could not locate the egg src directory from ${SUBMIT_DIR}" >&2
    exit 1
fi
cd "${WORK_DIR}"

# --- environment ------------------------------------------------------------
source "${WORK_DIR}/cluster/unicorn_env.sh"
# ---------------------------------------------------------------------------

python experiments/run_phase1.py --cell "${SLURM_ARRAY_TASK_ID}" --out runs/phase1
