#!/bin/bash
# Phase 1 array job — Unicorn cluster (Slurm).
#
# Preemption safety: --requeue + checkpointed drivers. A preempted/requeued
# task reruns the same command and resumes from its cell checkpoint; no work
# unit is lost beyond the in-flight MILP solve.
#
# Before first use:
#   1. Adjust the environment activation below to Unicorn's setup
#      (module load / conda / venv) so that `python` has egglab deps
#      (pip install -r src/requirements.txt) and gurobipy sees the license.
#   2. Size the array: N_CELLS-1 where N_CELLS comes from
#      `python experiments/run_phase1.py --list`.
#
#SBATCH --job-name=egg-phase1
#SBATCH --output=slurm-%x-%A_%a.out
#SBATCH --requeue
#SBATCH --array=0-15
#SBATCH --cpus-per-task=4
#SBATCH --mem=8G
#SBATCH --time=24:00:00

set -euo pipefail
cd "${SLURM_SUBMIT_DIR:-$(pwd)}"

# --- environment (EDIT ME for Unicorn) -------------------------------------
# module load gurobi python
# source /path/to/venv/bin/activate
export GRB_LICENSE_FILE="${GRB_LICENSE_FILE:-$HOME/gurobi.lic}"
# ---------------------------------------------------------------------------

python experiments/run_phase1.py --cell "${SLURM_ARRAY_TASK_ID}" --out runs/phase1
