#!/bin/bash
# Phase 2 array job — Unicorn cluster (Slurm). See submit_phase1.sub for the
# preemption/requeue and environment notes; identical pattern.
#
#SBATCH --job-name=egg-phase2
#SBATCH --output=slurm-%x-%A_%a.out
#SBATCH --mail-type=END,FAIL,REQUEUE
#SBATCH --requeue
#SBATCH --array=0-31
#SBATCH --cpus-per-task=4
#SBATCH --mem=8G
#SBATCH --time=24:00:00

set -euo pipefail
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
cd "${SLURM_SUBMIT_DIR:-$(pwd)}"

# --- environment ------------------------------------------------------------
source "${SCRIPT_DIR}/unicorn_env.sh"
# ---------------------------------------------------------------------------

python experiments/run_phase2.py --cell "${SLURM_ARRAY_TASK_ID}" --out runs/phase2
