#!/bin/bash
# Phase 2 array job — Unicorn cluster (Slurm). See submit_phase1.sub for the
# preemption/requeue and environment notes; identical pattern.
#
#SBATCH --job-name=egg-phase2
#SBATCH --output=slurm-%x-%A_%a.out
#SBATCH --mail-type=END,FAIL,REQUEUE
#SBATCH --requeue
#SBATCH --array=0-31
#SBATCH --cpus-per-task=4
#SBATCH --mem=8G
#SBATCH --time=24:00:00

set -euo pipefail
SUBMIT_DIR="${SLURM_SUBMIT_DIR:-$(pwd)}"
if [[ -f "${SUBMIT_DIR}/experiments/run_phase2.py" ]]; then
    WORK_DIR="${SUBMIT_DIR}"
elif [[ -f "${SUBMIT_DIR}/src/experiments/run_phase2.py" ]]; then
    WORK_DIR="${SUBMIT_DIR}/src"
else
    echo "ERROR: could not locate the egg src directory from ${SUBMIT_DIR}" >&2
    exit 1
fi
cd "${WORK_DIR}"

# --- environment ------------------------------------------------------------
source "${WORK_DIR}/cluster/unicorn_env.sh"
# ---------------------------------------------------------------------------

python experiments/run_phase2.py --cell "${SLURM_ARRAY_TASK_ID}" --out runs/phase2
